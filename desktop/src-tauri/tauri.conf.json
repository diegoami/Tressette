{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tressette",
  "version": "1.0.6",
  "identifier": "com.tressette.desktop",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "windows": [
      {
        "title": "Tressette",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
