<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- allowBackup is false on purpose. The settings and the last hundred
         hands live in WebView localStorage, and SPEC.md and the release notes
         both promise that nothing leaves the device. With the default true,
         Android's backup and device-transfer would carry that storage off the
         phone, which is the opposite of the promise (issue #24). No backup
         rules are declared: excluding the WebView's private storage by rule is
         more machinery for the same result, and it can only be verified on a
         device we do not have. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <!-- The app makes no network requests: everything it draws with is in
         assets/public/, which is the point of the fonts pass in
         tools/check_ui.mjs. This permission is still here because Capacitor
         does not load the page from file:// — it serves it to the WebView over
         an intercepted http://localhost origin, and a WebView will not load an
         http URL without it. ANDROID.md §2 and §7: dropping it can only be
         verified by installing the result, so it waits for a device. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
