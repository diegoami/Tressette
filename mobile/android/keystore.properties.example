# Copy this to keystore.properties (which is gitignored) and fill in the blanks.
# NEVER commit the real keystore.properties or the .jks it points at. Back both
# up somewhere that outlives this machine: if the key is lost, no future build
# can update an installed copy of the app.
#
# storeFile is an absolute path, or relative to mobile/android/. Keeping the key
# outside the repo (as here) is why this is absolute.
storeFile=/path/to/tressette-release.jks
storePassword=
keyAlias=tressette
# PKCS12 keystores (what JDK 21's keytool writes) have no separate key password,
# so this must equal storePassword.
keyPassword=
